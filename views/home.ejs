<%- include('top', { title: shopName }) %>

<main class="mesh">
  <section class="mx-auto max-w-6xl px-4 pb-12 pt-12 sm:px-8 sm:pt-16">
    <p class="text-xs uppercase tracking-[0.35em] text-gold">Addis Ababa · Made to wear</p>
    <h1 class="mt-3 max-w-3xl font-display text-5xl leading-[0.95] sm:text-7xl">Cloth that carries culture with quiet elegance.</h1>
    <p class="mt-5 max-w-xl text-lg text-muted">Habesha kemis and shifon . Browse the collection, then send a message to order.</p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-8">
    <div class="mb-8 flex items-end justify-between gap-4">
      <h2 class="font-display text-3xl">The collection</h2>
      <p class="text-sm text-muted"><%= products.length %> piece<%= products.length === 1 ? '' : 's' %></p>
    </div>

    <% if (products.length === 0) { %>
      <div class="rounded-3xl border border-dashed border-line bg-white/50 px-6 py-16 text-center">
        <p class="font-display text-3xl">Nothing is listed yet</p>
        <p class="mt-2 text-muted">Please check back soon for new kemis.</p>
      </div>
    <% } else { %>
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4">
        <% products.forEach(p => { %>
          <li>
            <a href="/product/<%= p.id %>" class="group block">
              <div class="relative mb-3 overflow-hidden rounded-2xl bg-wash shadow-[0_18px_40px_-28px_rgba(28,23,18,0.55)] ring-1 ring-black/5">
                <div class="aspect-[3/4]">
                  <% if (p.image) { %>
                    <img src="/uploads/<%= p.image %>" alt="<%= p.name %>" loading="lazy"
                         class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
                  <% } else { %>
                    <span class="absolute inset-0 grid place-items-center text-sm text-muted">No picture yet</span>
                  <% } %>
                </div>
              </div>
              <h3 class="font-display text-xl leading-snug group-hover:text-brand"><%= p.name %></h3>
              <p class="mt-0.5 text-muted"><%= Number(p.price).toLocaleString('en-US') %> ETB</p>
              <p class="mt-1 text-xs tracking-wider text-muted"><%= codeOf(p.id) %></p>
              <% if (p.description) { %>
                <p class="mt-1 line-clamp-2 text-xs text-muted/80">
                  <%= p.description.length > 70 ? p.description.slice(0, 70).trim() + '…' : p.description %>
                </p>
              <% } %>
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</main>

<%- include('footer') %>